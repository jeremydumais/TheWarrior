 
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--target",
                "all",
                "--",
                "-j",
                "10"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "run clang-tidy",
            "type": "shell",
            "command": "clang-tidy",
            "args": [
                "--checks=*,-fuchsia-default-arguments,-google-build-using-namespace",
                "-p=${workspaceFolder}/build",
                "${file}"
            ],
            "problemMatcher":"$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "run cppcheck",
            "type": "process",
            "command": "cppcheck",
            "args": [
                "--enable=all",
                "--inconclusive",
                "--std=posix",
                "--force",
                "${file}"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher":"$gcc"
        },
        {
            "label": "build project",
            "type": "shell",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--target",
                "${input:cmakeTarget}",
                "--",
                "-j",
                "10"
            ],
            "problemMatcher": "$gcc"
        }
    ],
    "inputs": [
        {
            "id": "cmakeTarget",
            "type": "pickString",
            "description": "Select the project to build",
            "options": [
                "theWarrior.Models",
                "theWarrior.Storage",
                "theWarrior.UI.Models",
                "theWarrior.UI.Controllers",
                "theWarrior.UI",
                "theWarrior.Utils",
                "TheWarrior",
                "commonEditor.UI",
                "MapEditor.Controllers",
                "MapEditor",
                "ItemEditor.Controllers",
                "ItemEditor",
                "MonsterEditor.Controllers",
                "MonsterEditor"
            ],
            "default": "theWarrior.Models"
        }
    ]
}
